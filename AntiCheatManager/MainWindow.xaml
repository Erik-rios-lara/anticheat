<Window x:Class="AntiCheatManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntiCheat L4D2 Manager" Height="500" Width="620"
        Background="#1e1e1e" Foreground="White" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AntiCheat L4D2 Manager" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Anti-Cheat Manager for Left 4 Dead 2" FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Center" Grid.Row="1" Margin="0,0,0,20"/>

        <!-- Path Selection -->
        <GroupBox Header="Left 4 Dead 2 Path" Foreground="White" BorderBrush="#555" Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPath" Background="#2d2d30" Foreground="White" BorderThickness="1" BorderBrush="#555" Padding="5" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnBrowse" Content="Buscar Manualmente" Grid.Column="1" Click="BtnBrowse_Click"/>
            </Grid>
        </GroupBox>

        <!-- Status -->
        <GroupBox Header="Estado del Sistema" Foreground="White" BorderBrush="#555" Grid.Row="3" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblMM" Text="[✗] MetaMod:Source no detectado" Foreground="#FF6666"/>
                <TextBlock x:Name="LblSM" Text="[✗] SourceMod no detectado" Foreground="#FF6666" Grid.Row="1"/>
                <TextBlock x:Name="LblAC" Text="[✗] Anti-Cheat no instalado" Foreground="#FF6666" Grid.Row="2"/>
                <TextBlock x:Name="LblServer" Text="Servidor detectado: DETENIDO" Foreground="#AAAAAA" Grid.Row="3"/>

                <Button x:Name="BtnCheckMMSM" Grid.Column="1" Grid.RowSpan="4"
                        Content="Escanear&#10;MM y SM"
                        VerticalAlignment="Center"
                        Padding="15,20"
                        Background="#444"
                        Click="BtnCheckMMSM_Click"/>
            </Grid>
        </GroupBox>

        <!-- Main Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnToggle" Content="ACTIVAR ANTI-CHEAT" FontSize="18" FontWeight="Bold" Padding="20,10" Background="#4CAF50" Click="BtnToggle_Click"/>
            <Button x:Name="BtnInstall" Content="Instalar Anti-Cheat" Padding="15,10" Background="#007ACC" Click="BtnInstall_Click"/>
        </StackPanel>

        <!-- Config and Logs -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button x:Name="BtnVerify" Content="Verificar Instalación" Click="BtnVerify_Click"/>
            <Button x:Name="BtnLogs" Content="Ver Logs" Click="BtnLogs_Click"/>
            <Button x:Name="BtnHelpSM" Content="Ayuda MetaMod/SourceMod" Click="BtnHelpSM_Click"/>
        </StackPanel>
    </Grid>
</Window>
